# STLA Guardian AI — Environment Configuration
# Copy this file to .env and fill in your values

# AI Model (Groq — free, fast inference)
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b
# Optional alternative AI provider. Use either GROQ_API_KEY or GEMINI_API_KEY.
GEMINI_API_KEY=your_gemini_api_key_here
# Leave false for real AI conversations. Set true only for an offline scripted demo.
DETERMINISTIC_DEMO=false
# Set false when demonstrating one fixed, real vehicle profile.
RANDOM_DEMO_VEHICLE=true

# Vehicle identity used by the live AI and dashboard. Replace every example
# value with the exact brand, model, trim, and specification for your demo car.
VEHICLE_BRAND=Your vehicle brand
VEHICLE_MODEL=Your exact model
VEHICLE_TRIM=Your exact trim and powertrain
VEHICLE_YEAR=2026
VEHICLE_VIN=YOUR_DEMO_VIN
VEHICLE_REGISTRATION=KA-01-AB-1234
VEHICLE_CURB_WEIGHT_KG=Your exact curb weight
VEHICLE_LENGTH_MM=Your exact length
VEHICLE_WIDTH_MM=Your exact width
VEHICLE_HEIGHT_MM=Your exact height

# Twilio Voice & WhatsApp
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_FROM_NUMBER=+1xxxxxxxxxx
TWILIO_ENGINEER_NUMBER=+91xxxxxxxxxx
TWILIO_TO_NUMBER=+91xxxxxxxxxx
TWILIO_MECHANIC_NUMBER=+91xxxxxxxxxx
TWILIO_DRIVER_NUMBER=+91xxxxxxxxxx
# Temporary demo override: routes engineer, mechanic, and driver calls to one phone.
# Remove it before production deployment.
DEMO_CONTACT_NUMBER=+91xxxxxxxxxx
TWILIO_WHATSAPP_NUMBER=+14155238886

# Webhook URL
# Local dev: use your ngrok URL (run: ngrok http 3001)
# Production: use your Render URL (e.g. https://stella-ai.onrender.com)
TWILIO_WEBHOOK_BASE_URL=https://your-url-here

# Server
PORT=3001
