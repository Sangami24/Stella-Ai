# STLA Guardian AI — Environment Variables

# Gemini AI (Required for AI diagnosis — uses smart fallback if not set)
GEMINI_API_KEY=your_gemini_api_key_here

# Twilio Voice (Optional — simulated call mode if not set)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_FROM_NUMBER=+1234567890
TWILIO_TO_NUMBER=+1234567890
TWILIO_WEBHOOK_BASE_URL=https://your-ngrok-url.ngrok.io

# Server
PORT=3001
